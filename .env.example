# Sao chép thành .env trên PC. KHÔNG commit .env (repo public).

# --- Postgres (docker compose) ---
POSTGRES_PASSWORD=change-me-superuser
CU_OWNER_PASSWORD=change-me-owner
CU_APP_PASSWORD=change-me-app
# App + worker dùng cu_app; migration dùng cu_owner.
DATABASE_URL=postgresql://cu_app:change-me-app@localhost:5442/cu
DATABASE_OWNER_URL=postgresql://cu_owner:change-me-owner@localhost:5442/cu

# --- Redis ---
REDIS_PASSWORD=change-me-redis
REDIS_URL=redis://:change-me-redis@localhost:6379

# --- math-verifier ---
MATH_VERIFIER_URL=http://localhost:8001

# --- stt-local (nhận dạng giọng nói trên GPU, giọng của con không rời PC) ---
# Dev: cổng 8002 do docker-compose.override.yml mở trên localhost. Trong Docker app dùng http://stt-local:8000.
STT_LOCAL_URL=http://localhost:8002
# Danh sách model theo ngôn ngữ, cách nhau dấu phẩy; model đầu là mặc định, model sau chỉ dùng cho A/B
# (stt-bench). Đổi danh sách thì chạy lại: docker compose run --rm stt-models-download
# STT_MODELS_VI=vinai/PhoWhisper-large,openai/whisper-large-v3-turbo
# STT_MODELS_EN=openai/whisper-large-v3-turbo
# Nạp sẵn khi khởi động: all | defaults | none | danh sách model. STT_DEVICE: auto | cuda | cpu (compose mặc định cuda: GPU lỗi thì container dừng, không lặng lẽ chạy CPU).
# STT_PRELOAD=all
# STT_DEVICE=auto              # chỉ đặt khi dev trên máy không có GPU

# --- LLM ---
CLAUDE_API_KEY=
# Bắt buộc khi API key không gắn với workspace (Console › Workspaces).
CLAUDE_WORKSPACE_ID=
OPENROUTER_API_KEY=
# Eval dùng key và trần chi phí riêng, không fallback OpenRouter.
ANTHROPIC_API_KEY_EVAL=
ANTHROPIC_WORKSPACE_ID_EVAL=
EVAL_COST_CAP_USD=60

# --- Phiên đăng nhập ---
SESSION_SECRET=change-me-32-bytes-random
ADMIN_SESSION_SECRET=change-me-another-32-bytes
ADMIN_ENABLED=false

# --- Cloudflare Turnstile (test keys chính thức của Cloudflare: luôn pass) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Email thông báo phụ huynh ---
SMTP_URL=smtp://localhost:1025
SMTP_FROM=cu@localhost
APP_BASE_URL=http://localhost:3000

# --- Lưu trữ ảnh đề (ngoài web root) ---
STORAGE_DIR=./storage
