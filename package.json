{
  "name": "cu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker:dev": "tsx watch --conditions=react-server worker/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "postinstall": "prisma generate",
    "admin:create": "tsx --conditions=react-server scripts/create-first-admin.ts",
    "llm:smoke": "tsx --conditions=react-server scripts/llm-smoke.ts",
    "eval:presolve": "tsx --conditions=react-server eval/presolve-acceptance.ts",
    "eval": "tsx --conditions=react-server eval/run-eval.ts",
    "eval:ci": "tsx --conditions=react-server eval/run-eval.ts --ci",
    "eval:smoke": "tsx --conditions=react-server eval/run-eval.ts --smoke",
    "prod:up": "docker compose -f docker-compose.yml --profile prod up -d --build",
    "prod:down": "docker compose -f docker-compose.yml --profile prod down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^6.3.17",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "dotenv": "^18.0.8",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "smtp-server": "^3.20.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver",
      "sharp",
      "argon2",
      "@node-rs/argon2"
    ]
  }
}
